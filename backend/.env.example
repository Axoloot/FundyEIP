# Copy to .env (or .envrc with `export`) and fill in. Never commit the real file.
PORT=8000
DATABASE_URL=postgresql://prisma:prisma@localhost:5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=prisma
DATABASE_PASSWORD=prisma

REDIS_HOST=localhost
REDIS_PASSWORD=12345678
SESSION_SECRET=change-me

# Optional third parties (features using them fail without keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NORDIGEN_CLIENT_ID=
NORDIGEN_CLIENT_SECRET=
NORDIGEN_REDIRECT_URL=http://localhost:3000/callback
MAIL_USER=
MAIL_PASSWORD=
