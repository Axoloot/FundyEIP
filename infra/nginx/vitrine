server {
    listen 443 http2 ssl;
    listen [::]:443 http2 ssl;
    root /var/www/site-vitrine;
    index index.html;
    server_name vitrine.fundy.cf;
    location / {
      try_files $uri /index.html;
    }

    location ~* \.(jpg|jpeg|png|gif|ico)$ {
      expires 30d;
    }
    location ~* \.(css|js)$ {
      expires 7d;
    }

    ssl on;
    ssl_certificate /etc/letsencrypt/live/fundy.cf/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fundy.cf/privkey.pem;

    gzip on;
    gzip_types application/javascript image/* text/css;
    gunzip on;
}

server {
    listen 0.0.0.0:80;
    server_name vitrine.fundy.cf;
    rewrite ^ https://$host$request_uri? permanent;
}

